{
  "manifest_version": 3,
  "name": "Web Char Companion",
  "version": "0.2.0",
  "description": "A character virtual companion that lives on top of web pages and reacts contextually to the DOM.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "alarms",
    "offscreen"
  ],
  "optional_permissions": ["notifications"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Web Char Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle",
      "js": [
        "src/shared/constants.js",
        "src/shared/alarm-schedule.js",
        "src/shared/character-loader.js",
        "src/content/renderer.js",
        "src/content/video-watcher.js",
        "src/content/dom-scanner.js",
        "src/content/target-selector.js",
        "src/content/movement-engine.js",
        "src/content/behavior-engine.js",
        "src/content/interaction.js",
        "src/content/alarm.js",
        "src/content/index.js"
      ]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["src/content/video-watcher-frame.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/chars/*/*.png", "assets/chars/*/animation.json"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
